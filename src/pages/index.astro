---
// Portfolio page: plain HTML, CSS and vanilla JS (no framework code).
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Yavuz Atilgan Portfolio</title>
	<meta name="description" content="Yavuz Atilgan, software engineering student and AI specialist. Front-end, back-end and full stack." />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Barlow+Condensed:wght@500;600;700&display=swap">
	<style is:global>
/* ============================================================
   YAVUZ ATILGAN - PORTFOLIO
   BMW / M-inspired design system
   ============================================================ */

/* ---------- 1. TOKENS ---------- */
:root{
  /* M stripe palette */
  --m-light:#009ADA;
  --m-blue:#0653B6;
  --m-red:#E7222E;
  --bmw:#0066B1;

  /* neutrals */
  --ink:#08090B;
  --ink-2:#0C0E11;
  --panel:#12151A;
  --panel-2:#171B21;
  --line:rgba(255,255,255,.09);
  --line-2:rgba(255,255,255,.16);
  --text:#EDEFF2;
  --muted:#8B939D;
  --muted-2:#5F666F;

  /* accent (switches in M mode) */
  --accent:var(--m-light);
  --accent-soft:rgba(0,154,218,.14);

  --wrap:1180px;
  --pad:clamp(20px,5vw,56px);
  --r:2px;

  --ease:cubic-bezier(.22,.61,.36,1);
  --ease-out:cubic-bezier(.16,1,.3,1);

  --mono:"Barlow Condensed",'Inter',system-ui,sans-serif;
  --sans:'Inter',system-ui,-apple-system,"Segoe UI",sans-serif;
}

body.m-mode{ --accent:var(--m-red); --accent-soft:rgba(231,34,46,.16); }

/* ---------- 2. RESET / BASE ---------- */
*,*::before,*::after{ box-sizing:border-box }
html{ scroll-behavior:smooth; -webkit-text-size-adjust:100% }
body{
  margin:0;
  background:var(--ink);
  color:var(--text);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
body.is-booting{ overflow:hidden; height:100vh }
body.nav-open{ overflow:hidden; position:fixed; left:0; right:0; width:100% }
img,svg{ max-width:100% }
h1,h2,h3{ margin:0; line-height:1.02; letter-spacing:-.035em; font-weight:800 }
p{ margin:0 0 1.1em }
a{ color:inherit; text-decoration:none }
ul,ol{ margin:0; padding:0; list-style:none }
kbd{
  font-family:var(--sans); font-size:10px; font-weight:600; letter-spacing:.06em;
  border:1px solid var(--line-2); border-radius:3px; padding:1px 5px;
  background:rgba(255,255,255,.05);
}
::selection{ background:var(--accent); color:#fff }

.wrap{ width:100%; max-width:var(--wrap); margin:0 auto; padding:0 var(--pad) }

/* ---------- the YSA roundel ---------- */
.roundel{ display:block }
.rd-rim{ fill:#EEF2F6 }
.rd-ring{ fill:#08090B }
.rd-inner{ fill:#FFFFFF }
.rd-q{ fill:#0C6EC6; transition:fill .4s }
body.m-mode .rd-q{ fill:var(--m-red) }
.rd-txt text{
  font-family:var(--sans); font-size:17.5px; font-weight:800;
  fill:#FFFFFF;
}

/* ---------- 3. SHARED ATOMS ---------- */
.ico{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:square; flex:0 0 auto }

.btn{
  --bg:var(--text); --fg:#0A0C0F;
  display:inline-flex; align-items:center; gap:10px;
  background:var(--bg); color:var(--fg);
  font-size:13px; font-weight:700; letter-spacing:.02em;
  padding:15px 24px; border:1px solid var(--bg); border-radius:var(--r);
  position:relative; overflow:hidden; isolation:isolate;
  transition:color .35s var(--ease), border-color .35s var(--ease);
}
.btn::after{
  content:""; position:absolute; inset:0; z-index:-1;
  background:linear-gradient(90deg,var(--m-light),var(--m-blue) 55%,var(--m-red));
  transform:translateX(-101%); transition:transform .5s var(--ease-out);
}
.btn:hover{ color:#fff; border-color:transparent }
.btn:hover::after{ transform:translateX(0) }
.btn .ico{ transition:transform .35s var(--ease) }
.btn:hover .ico{ transform:translateX(4px) }
.btn--ghost{ --bg:transparent; --fg:var(--text); border-color:var(--line-2) }
.btn--sm{ padding:10px 16px; font-size:12px }
.btn--block{ width:100%; justify-content:space-between; margin-top:14px }

/* eyebrow + section labels */
.eyebrow,.sec__label{
  font-family:var(--mono); font-size:13px; font-weight:600;
  letter-spacing:.22em; text-transform:uppercase; color:var(--muted);
  display:flex; align-items:center; gap:12px; margin:0 0 22px;
}
.eyebrow em,.sec__label em{ color:var(--muted-2); font-style:normal }
.eyebrow__tick,.sec__label i{
  width:34px; height:3px; flex:0 0 auto; border-radius:2px;
  background:linear-gradient(90deg,var(--m-light) 0 33.3%,var(--m-blue) 33.3% 66.6%,var(--m-red) 66.6%);
}
.sec__label--center{ justify-content:center }

.sec{ padding:clamp(84px,11vw,150px) 0; position:relative }
.sec--alt{ background:var(--ink-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line) }
.sec__head{ margin-bottom:clamp(44px,6vw,72px); max-width:760px }
.sec__head--center{ margin-inline:auto; text-align:center }
.sec__title{ font-size:clamp(34px,6vw,62px) }
.sec__sub{ color:var(--muted); font-size:17px; margin:20px 0 0; max-width:60ch }
.sec__head--center .sec__sub{ margin-inline:auto }

.tags{ display:flex; flex-wrap:wrap; gap:8px; margin-top:26px }
.tags li{
  font-family:var(--mono); font-size:13px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--muted); border:1px solid var(--line); border-radius:var(--r);
  padding:6px 12px; background:rgba(255,255,255,.02);
  transition:color .3s,border-color .3s,background .3s;
}
.tags li:hover{ color:var(--text); border-color:var(--accent); background:var(--accent-soft) }
.tags--lg{ gap:10px }
.tags--lg li{ font-size:14px; padding:9px 15px }

/* reveal-on-scroll */
.reveal{ opacity:0; transform:translateY(26px); transition:opacity .8s var(--ease-out),transform .8s var(--ease-out) }
.reveal.in{ opacity:1; transform:none }

/* ============================================================
   4. BOOT SCREEN
   ============================================================ */
.boot{
  position:fixed; inset:0; z-index:200;
  background:#05070A;
  display:grid; place-items:center;
  overflow:hidden;
}
.boot.done{ pointer-events:none }
.boot.gone{ display:none }

.boot__stripes{ position:absolute; top:0; left:0; right:0; height:3px; display:flex; z-index:3 }
.boot__stripes i{ flex:1; transform:scaleX(0); transform-origin:left; animation:bootStripe .7s var(--ease-out) forwards }
.boot__stripes i:nth-child(1){ background:var(--m-light) }
.boot__stripes i:nth-child(2){ background:var(--m-blue); animation-delay:.1s }
.boot__stripes i:nth-child(3){ background:var(--m-red); animation-delay:.2s }
@keyframes bootStripe{ to{ transform:scaleX(1) } }

.boot__center{ position:relative; z-index:4; display:grid; justify-items:center; gap:26px; padding:24px; text-align:center }

.boot__mark{ width:clamp(124px,19vw,168px); height:auto; animation:bootPop .9s var(--ease-out) both }
@keyframes bootPop{ from{ opacity:0; transform:scale(.86) } to{ opacity:1; transform:none } }
.boot__ring-bg{ fill:none; stroke:rgba(255,255,255,.08); stroke-width:3 }
.boot__ring{
  fill:none; stroke-width:3; stroke-linecap:round;
  stroke-dasharray:358; stroke-dashoffset:358;
  transform:rotate(-90deg); transform-origin:50px 50px;
  animation:bootRing 2.3s var(--ease) .25s forwards;
}
@keyframes bootRing{ to{ stroke-dashoffset:0 } }
@keyframes bootFade{ to{ opacity:1 } }

.boot__title{
  font-family:var(--mono); font-size:14px; font-weight:600;
  letter-spacing:.34em; text-transform:uppercase; color:#fff;
}
.boot__title span{ color:var(--m-light); letter-spacing:.2em }
.boot__log{
  font-family:var(--mono); font-size:13px; letter-spacing:.09em; color:var(--muted);
  margin-top:12px; min-height:7.4em; text-align:left; width:min(400px,86vw);
}
.boot__log div{ display:flex; justify-content:space-between; gap:10px; opacity:0; animation:bootFade .3s forwards }
.boot__log b{ color:#3FCF6E; font-weight:600 }
.boot__log b.warn{ color:var(--m-light) }

.boot__bar{ display:flex; align-items:center; gap:16px; width:min(400px,86vw) }
.boot__bar-track{ flex:1; height:2px; background:rgba(255,255,255,.12); overflow:hidden }
.boot__bar-fill{
  height:100%; width:0%;
  background:linear-gradient(90deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
}
.boot__bar-num{ font-family:var(--mono); font-size:15px; letter-spacing:.08em; color:#fff; min-width:46px; text-align:right }
.boot__bar-num em{ font-style:normal; color:var(--muted-2); font-size:11px; margin-left:2px }

.boot__skip{
  position:absolute; bottom:28px; right:28px; z-index:5;
  background:none; border:0; cursor:pointer; color:var(--muted-2);
  font-family:var(--mono); font-size:12px; letter-spacing:.16em; text-transform:uppercase;
  display:flex; align-items:center; gap:8px; transition:color .3s;
}
.boot__skip:hover{ color:#fff }

/* curtain split reveal */
.boot__curtain{ position:absolute; top:0; bottom:0; width:51%; background:#05070A; z-index:2; transition:transform 1s var(--ease-out) }
.boot__curtain--l{ left:0 }
.boot__curtain--r{ right:0 }
.boot__curtain--r::before,.boot__curtain--l::before{
  content:""; position:absolute; top:0; bottom:0; width:1px;
  background:linear-gradient(180deg,transparent,var(--m-light),transparent); opacity:0; transition:opacity .3s;
}
.boot__curtain--l::before{ right:0 }
.boot__curtain--r::before{ left:0 }
.boot.done .boot__center,.boot.done .boot__skip,.boot.done .boot__stripes{ opacity:0; transition:opacity .3s }
.boot.done .boot__curtain::before{ opacity:1 }
.boot.done .boot__curtain--l{ transform:translateX(-100%) }
.boot.done .boot__curtain--r{ transform:translateX(100%) }
.boot.done{ background:transparent }

/* ============================================================
   5. PROGRESS + NAV
   ============================================================ */
.progress{ position:fixed; top:0; left:0; right:0; height:2px; z-index:120; background:rgba(255,255,255,.06) }
.progress i{
  display:block; height:100%; width:0;
  background:linear-gradient(90deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
}

.nav{
  position:fixed; top:0; left:0; right:0; z-index:110;
  display:flex; align-items:center; gap:24px;
  padding:16px var(--pad);
  transition:background .4s var(--ease),border-color .4s,padding .4s var(--ease);
  border-bottom:1px solid transparent;
}
.nav.stuck{
  background:rgba(8,9,11,.82);
  backdrop-filter:blur(14px) saturate(140%);
  -webkit-backdrop-filter:blur(14px) saturate(140%);
  border-bottom-color:var(--line);
  padding-block:11px;
}
.nav__brand{ display:flex; align-items:center; gap:11px; margin-right:auto }
.nav__logo{ width:36px; height:36px; display:block }
.nav__logo svg{ display:block }
.nav__brand:hover .rd-q{ fill:var(--accent) }
.nav__name{ font-size:15px; font-weight:800; letter-spacing:.04em }
.nav__name b{
  background:linear-gradient(160deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}

.nav__links{ display:flex; gap:4px }
.nav__links a{
  font-family:var(--mono); font-size:14px; font-weight:600;
  letter-spacing:.14em; text-transform:uppercase; color:var(--muted);
  padding:8px 13px; border-radius:var(--r); position:relative; transition:color .3s;
}
.nav__links a::after{
  content:""; position:absolute; left:13px; right:13px; bottom:2px; height:2px;
  background:var(--accent); transform:scaleX(0); transform-origin:left;
  transition:transform .4s var(--ease-out);
}
.nav__links a:hover{ color:var(--text) }
.nav__links a.active{ color:#fff }
.nav__links a.active::after,.nav__links a:hover::after{ transform:scaleX(1) }

.nav__burger{ display:none; background:none; border:0; cursor:pointer; padding:8px; flex-direction:column; gap:5px }
.nav__burger i{ display:block; width:22px; height:2px; background:var(--text); transition:transform .3s,opacity .3s }
body.nav-open .nav__burger i:nth-child(1){ transform:translateY(7px) rotate(45deg) }
body.nav-open .nav__burger i:nth-child(2){ opacity:0 }
body.nav-open .nav__burger i:nth-child(3){ transform:translateY(-7px) rotate(-45deg) }

/* ============================================================
   6. HERO
   ============================================================ */
.hero{
  position:relative; min-height:100svh; isolation:isolate;
  display:flex; align-items:center;
  padding:120px 0 90px; overflow:hidden;
}
.hero__stars{ position:absolute; inset:0; width:100%; height:100%; z-index:0; contain:strict }
.hero__glow{
  position:absolute; z-index:0; left:50%; top:42%; width:min(1100px,120vw); aspect-ratio:1;
  transform:translate(-50%,-50%);
  background:radial-gradient(circle,rgba(0,102,177,.20),rgba(6,83,182,.07) 42%,transparent 66%);
  pointer-events:none;
}
body.m-mode .hero__glow{ background:radial-gradient(circle,rgba(231,34,46,.18),rgba(6,83,182,.08) 42%,transparent 66%) }

/* kidney grille motif */
.hero__grille{
  position:absolute; z-index:0; left:50%; bottom:-12%; transform:translateX(-50%);
  display:flex; gap:14px; opacity:.5; pointer-events:none;
}
.hero__grille span{
  width:min(20vw,190px); height:min(34vw,300px);
  border:1px solid rgba(255,255,255,.10);
  border-radius:40% 40% 46% 46%/58% 58% 34% 34%;
  background:repeating-linear-gradient(90deg,rgba(255,255,255,.055) 0 2px,transparent 2px 13px);
  -webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.85),transparent 82%);
  mask-image:linear-gradient(180deg,rgba(0,0,0,.85),transparent 82%);
}
.hero__grille span:last-child{ transform:scaleX(-1) }

.hero__inner{ position:relative; z-index:2 }

/* name */
.hero__name{
  display:flex; align-items:flex-start; gap:.02em;
  font-size:clamp(66px,17.5vw,232px);
  font-weight:900; letter-spacing:-.055em; line-height:.86;
  margin:0 0 8px; cursor:pointer; user-select:none;
  transition:transform .4s var(--ease);
}
.hero__word{
  background:linear-gradient(180deg,#fff 30%,#9AA3AD);
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero__a{ display:block; width:.72em; margin-left:.045em; position:relative; top:.008em }
.hero__a-svg{ display:block; width:100%; height:auto; overflow:visible }
.hero__a-stripes{ transform:skewX(-20.4deg); transform-origin:60px 70px }
.stripe.s2{ fill:var(--m-light) }
.stripe.s3{ fill:var(--m-blue) }
.stripe.s4{ fill:var(--m-red) }

/* trailing edge: edge light + the air it cuts */
.hero__a-edge{
  fill:none; stroke:url(#aEdge); stroke-width:2.2; stroke-linecap:round;
}

.hero__a-frags{ animation:aDrift 6.5s var(--ease) infinite alternate }
@keyframes aDrift{
  from{ transform:translateX(0); opacity:.85 }
  to{ transform:translateX(10px); opacity:1 }
}
.hero__a-halo{ opacity:.9; animation:aHalo 6.5s var(--ease) infinite alternate }
@keyframes aHalo{ from{ opacity:.55 } to{ opacity:1 } }
.hero-paused .hero__a-frags,
.hero-paused .hero__a-halo{ animation-play-state:paused }
body.m-mode .hero__a-halo{ opacity:1 }
.hero__a-shine{
  fill:url(#aShineGrad); transform:skewX(-20.4deg);
  animation:aShine 5.5s var(--ease) 1.4s infinite;
  will-change:transform;
}
.hero-paused .hero__a-shine{ animation-play-state:paused }
@keyframes aShine{ 0%{ transform:skewX(-20.4deg) translateX(0) } 26%,100%{ transform:skewX(-20.4deg) translateX(300px) } }
.hero__name:hover{ transform:translateY(-3px) }
.hero__name.shatter{ animation:nameKick .5s var(--ease) }
@keyframes nameKick{ 30%{ transform:translateX(-8px) skewX(1.4deg) } 60%{ transform:translateX(5px) } }

.hero__tagline{
  font-family:var(--mono); font-size:clamp(19px,2.6vw,30px); font-weight:600;
  letter-spacing:.06em; margin:0 0 22px; color:#fff;
}
.hero__tagline::after{
  content:""; display:block; width:64px; height:3px; margin-top:16px;
  background:linear-gradient(90deg,var(--m-light) 0 33.3%,var(--m-blue) 33.3% 66.6%,var(--m-red) 66.6%);
}
.hero__lede{ max-width:56ch; color:var(--muted); font-size:clamp(15px,1.5vw,18px) }
.hero__cta{ display:flex; flex-wrap:wrap; gap:12px; margin:32px 0 0 }

/* spec sheet */
.spec{
  display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
  margin:56px 0 0; background:var(--line);
  border:1px solid var(--line); border-radius:var(--r); overflow:hidden;
}
.spec__i{ background:rgba(10,12,15,.82); padding:18px 20px }
.spec dt{
  font-family:var(--mono); font-size:12px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--muted-2); margin-bottom:7px;
}
.spec dd{ margin:0; font-size:18px; font-weight:700; letter-spacing:-.02em }
.spec dd span{
  display:block; font-family:var(--mono); font-size:13px; font-weight:500;
  letter-spacing:.08em; color:var(--muted); margin-top:3px;
}

.scrolldown{
  position:absolute; left:50%; bottom:26px; transform:translateX(-50%); z-index:2;
  display:flex; flex-direction:column; align-items:center; gap:10px;
  font-family:var(--mono); font-size:11px; letter-spacing:.3em; color:var(--muted-2);
}
.scrolldown i{ width:1px; height:44px; background:linear-gradient(180deg,var(--muted-2),transparent); position:relative; overflow:hidden }
.scrolldown i::after{
  content:""; position:absolute; inset:0; background:var(--accent);
  animation:scrollDot 2.1s var(--ease) infinite;
}
@keyframes scrollDot{ 0%{ transform:translateY(-100%) } 60%,100%{ transform:translateY(100%) } }

/* ============================================================
   7. PROFILE
   ============================================================ */
.profile{ display:grid; grid-template-columns:1.35fr 1fr; gap:clamp(30px,5vw,72px); align-items:start }
.profile__text .lead{ font-size:clamp(19px,2.1vw,25px); font-weight:600; letter-spacing:-.02em; color:#fff; line-height:1.4 }
.profile__text p{ color:var(--muted) }

.datacard{
  position:relative; background:var(--panel); border:1px solid var(--line);
  border-radius:var(--r); overflow:hidden;
}
.datacard::before{
  content:""; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--m-light) 0 33.3%,var(--m-blue) 33.3% 66.6%,var(--m-red) 66.6%);
}
.datacard__top{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding:20px 22px 14px }
.datacard__badge{
  font-family:var(--mono); font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:#fff;
}
.datacard__vin{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; color:var(--muted-2) }
.datacard__table{ width:100%; border-collapse:collapse; font-size:14px; position:relative; z-index:1 }
.datacard__table th,.datacard__table td{ text-align:left; padding:13px 22px; border-top:1px solid var(--line); vertical-align:top }
.datacard__table th{
  font-family:var(--mono); font-weight:500; font-size:13px; letter-spacing:.14em;
  text-transform:uppercase; color:var(--muted-2); width:38%;
}
.datacard__table td{ color:var(--text); font-weight:500 }
.datacard__table td.hl{ color:var(--m-light); font-weight:700; letter-spacing:.02em }
.dot{
  display:inline-block; width:7px; height:7px; border-radius:50%; background:#3FCF6E;
  margin-right:8px; box-shadow:0 0 0 0 rgba(63,207,110,.6); animation:pulse 2.4s infinite;
}
@keyframes pulse{ 70%{ box-shadow:0 0 0 8px rgba(63,207,110,0) } 100%{ box-shadow:0 0 0 0 rgba(63,207,110,0) } }
.datacard__grille{
  height:70px; margin:0; opacity:.5;
  background:repeating-linear-gradient(90deg,rgba(255,255,255,.06) 0 2px,transparent 2px 12px);
  border-top:1px solid var(--line);
}

/* ============================================================
   8. GAUGES
   ============================================================ */
.gauges{ display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line) }
.gauge{
  background:var(--ink); padding:28px 22px 24px; text-align:center;
  position:relative; overflow:hidden; transition:background .4s;
}
.gauge:hover{ background:var(--panel) }
.gauge__svg{ width:100%; max-width:172px; margin:0 auto; display:block; overflow:visible }
.g-track{ fill:none; stroke:rgba(255,255,255,.09); stroke-width:6; stroke-linecap:round }
.g-fill{
  fill:none; stroke:var(--accent); stroke-width:6; stroke-linecap:round;
  stroke-dasharray:var(--len); stroke-dashoffset:var(--len);
  transition:stroke-dashoffset 1.8s var(--ease-out), stroke .4s;
}
.gauge.in .g-fill{ stroke-dashoffset:var(--off) }
.g-red{ fill:none; stroke:var(--m-red); stroke-width:6; stroke-linecap:butt; opacity:.85 }
.g-tick{ stroke:rgba(255,255,255,.22); stroke-width:1.5 }
.g-needle{
  transform:rotate(-125deg); transform-origin:60px 60px;
  transition:transform 1.9s var(--ease-out);
}
.gauge.in .g-needle{ transform:rotate(var(--deg)) }
.g-needle path{ stroke:#fff; stroke-width:2.5; stroke-linecap:round }
.g-hub{ fill:#fff }
.g-val{ font-family:var(--mono); font-size:19px; font-weight:700; fill:#fff; letter-spacing:.02em }
.g-unit{ font-family:var(--mono); font-size:9px; fill:var(--muted-2); letter-spacing:.2em }
.gauge__name{ font-size:15px; font-weight:700; letter-spacing:-.01em; margin:10px 0 4px }
.gauge__meta{
  font-family:var(--mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--muted-2); margin:0;
}

.stackbar{ margin-top:54px; padding-top:38px; border-top:1px solid var(--line) }
.stackbar__label{
  font-family:var(--mono); font-size:13px; letter-spacing:.22em; text-transform:uppercase;
  color:var(--muted); margin:0;
}

/* ============================================================
   9. GARAGE / PROJECTS
   ============================================================ */
.garage{ display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(16px,2.2vw,28px) }
.car{
  position:relative; background:var(--panel); border:1px solid var(--line);
  border-radius:var(--r); overflow:hidden; display:flex; flex-direction:column;
  transition:transform .5s var(--ease-out),border-color .4s,background .4s;
}
.car::after{
  content:""; position:absolute; left:0; right:0; top:0; height:2px; z-index:2;
  background:linear-gradient(90deg,var(--m-light) 0 33.3%,var(--m-blue) 33.3% 66.6%,var(--m-red) 66.6%);
  transform:scaleX(0); transform-origin:left; transition:transform .6s var(--ease-out);
}
.car:hover{ transform:translateY(-6px); border-color:var(--line-2); background:var(--panel-2) }
.car:hover::after{ transform:scaleX(1) }

.car__media{
  position:relative; aspect-ratio:2/1; background:#0B0E12;
  border-bottom:1px solid var(--line); overflow:hidden;
}
.car__idx{
  position:absolute; top:14px; left:18px; z-index:2;
  font-family:var(--mono); font-size:12px; letter-spacing:.24em; color:var(--muted-2);
}
.car__art{ width:100%; height:100%; display:block }
.car__grid path{ stroke:rgba(255,255,255,.055); stroke-width:1; fill:none }
.car__line{
  fill:none; stroke:var(--accent); stroke-width:2.5; stroke-linecap:round; stroke-linejoin:round;
  stroke-dasharray:1400; stroke-dashoffset:1400; transition:stroke-dashoffset 2s var(--ease-out),stroke .4s;
}
.car.in .car__line{ stroke-dashoffset:0 }
.car__pt{ fill:none; stroke:#fff; stroke-width:2; opacity:0; transition:opacity .6s .9s }
.car.in .car__pt{ opacity:.9 }
.car__box,.car__bars rect{ fill:rgba(255,255,255,.07); stroke:rgba(255,255,255,.2); stroke-width:1 }
.car__bars rect{ transform-origin:center bottom; transform:scaleY(0); transition:transform .9s var(--ease-out) }
.car.in .car__bars rect{ transform:scaleY(1) }
.car.in .car__bars rect:nth-child(2){ transition-delay:.08s }
.car.in .car__bars rect:nth-child(3){ transition-delay:.16s }
.car.in .car__bars rect:nth-child(4){ transition-delay:.24s }
.car.in .car__bars rect:nth-child(5){ transition-delay:.32s }
.car.in .car__bars rect:nth-child(6){ transition-delay:.4s }
.car:hover .car__box{ fill:var(--accent-soft); stroke:var(--accent) }
.car__box{ transition:fill .4s,stroke .4s }

.car__body{ padding:26px clamp(20px,2.4vw,30px) 30px; flex:1; display:flex; flex-direction:column }
.car__body h3{ font-size:clamp(23px,2.6vw,30px) }
.car__type{
  font-family:var(--mono); font-size:13px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--accent); margin:9px 0 14px; transition:color .4s;
}
.car__body > p{ color:var(--muted); font-size:15px; margin-bottom:18px }
.chips{ display:flex; flex-wrap:wrap; gap:7px; margin-bottom:20px }
.chips li{
  font-family:var(--mono); font-size:12px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--muted); background:rgba(255,255,255,.045); border-radius:var(--r); padding:5px 10px;
}
.car__stats{ display:flex; gap:28px; margin-top:auto; padding-top:20px; border-top:1px solid var(--line) }
.car__stats b{ display:block; font-size:21px; font-weight:800; letter-spacing:-.02em }
.car__stats span{
  font-family:var(--mono); font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted-2);
}

/* ============================================================
   10. ROUTE / TIMELINE
   ============================================================ */
.route{ position:relative; max-width:860px; padding-left:0 }
.route::before{
  content:""; position:absolute; left:104px; top:12px; bottom:12px; width:1px;
  background:linear-gradient(180deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
  opacity:.55;
}
.route__i{ display:grid; grid-template-columns:104px 1fr; gap:0; padding-bottom:34px }
.route__i:last-child{ padding-bottom:0 }
.route__yr{
  font-family:var(--mono); font-size:18px; font-weight:700; letter-spacing:.16em;
  text-transform:uppercase; color:var(--muted); padding-top:21px;
}
.route__c{
  position:relative; margin-left:34px; background:var(--panel);
  border:1px solid var(--line); border-radius:var(--r); padding:22px 26px;
  transition:border-color .4s,transform .5s var(--ease-out);
}
.route__c::before{
  content:""; position:absolute; left:-34px; top:28px; width:9px; height:9px;
  border-radius:50%; background:var(--ink); border:2px solid var(--accent);
  transform:translateX(-4px); transition:border-color .4s,box-shadow .4s;
}
.route__i:hover .route__c{ border-color:var(--line-2); transform:translateX(4px) }
.route__i:hover .route__c::before{ box-shadow:0 0 0 5px var(--accent-soft) }
.route__c h3{ font-size:20px; display:flex; align-items:center; gap:12px; flex-wrap:wrap }
.route__c p{ color:var(--muted); font-size:15px; margin:10px 0 0 }
.route__tag{
  font-family:var(--mono); font-size:11px; font-weight:600; letter-spacing:.16em; text-transform:uppercase;
  color:#fff; background:var(--m-blue); padding:4px 9px; border-radius:var(--r); letter-spacing:.14em;
}

/* ============================================================
   11. WHY BMW
   ============================================================ */
.bmw{ position:relative; overflow:hidden }
.bmw__stripes{ position:absolute; inset:0; display:flex; opacity:.05; pointer-events:none }
.bmw__stripes i{ flex:1; transform:skewX(-14deg) }
.bmw__stripes i:nth-child(1){ background:var(--m-light) }
.bmw__stripes i:nth-child(2){ background:var(--m-blue) }
.bmw__stripes i:nth-child(3){ background:var(--m-red) }

.pillars{ display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); position:relative }
.pillar{ background:var(--ink); padding:clamp(26px,3vw,38px); transition:background .4s }
.pillar:hover{ background:var(--panel) }
.pillar__n{
  font-family:var(--mono); font-size:13px; letter-spacing:.24em; color:var(--muted-2);
  display:block; margin-bottom:20px;
}
.pillar h3{ font-size:22px; margin-bottom:14px }
.pillar p{ color:var(--muted); font-size:15px; margin:0 }

.quote{ margin:clamp(44px,6vw,72px) auto 0; max-width:820px; text-align:center; position:relative }
.quote p{
  font-size:clamp(21px,3vw,34px); font-weight:700; letter-spacing:-.03em; line-height:1.28;
  color:#fff; margin:0;
}
.quote p::before{ content:"\201C" }
.quote p::after{ content:"\201D" }
.quote cite{
  display:block; margin-top:22px; font-family:var(--mono); font-size:13px;
  letter-spacing:.24em; text-transform:uppercase; color:var(--muted); font-style:normal;
}

/* ============================================================
   12. CONTACT + FOOTER
   ============================================================ */
.contact__box{
  display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(30px,5vw,64px);
  background:var(--panel); border:1px solid var(--line); border-radius:var(--r);
  padding:clamp(30px,4.4vw,60px); position:relative; overflow:hidden;
}
.contact__box::before{
  content:""; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--m-light) 0 33.3%,var(--m-blue) 33.3% 66.6%,var(--m-red) 66.6%);
}
.contact__title{ font-size:clamp(30px,4.4vw,50px) }
.contact__sub{ color:var(--muted); margin:20px 0 0; max-width:42ch }
.link-row{
  display:flex; align-items:center; gap:16px; padding:16px 4px;
  border-top:1px solid var(--line); transition:padding .35s var(--ease),color .3s;
}
.link-row:first-child{ border-top:0 }
.link-row__k{
  font-family:var(--mono); font-size:12px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--muted-2); width:82px; flex:0 0 auto;
}
.link-row__v{ font-weight:600; font-size:15px; margin-right:auto; word-break:break-all }
.link-row .ico{ color:var(--muted-2); transition:transform .35s var(--ease),color .3s }
.link-row:hover{ padding-left:12px }
.link-row:hover .ico{ transform:translateX(4px); color:var(--accent) }

.foot{ border-top:1px solid var(--line); background:var(--ink-2); padding:44px 0 40px }
.foot__in{ display:grid; gap:12px; text-align:center }
.foot__name{ font-size:20px; font-weight:800; letter-spacing:.06em; margin:0 }
.foot__name b{
  background:linear-gradient(160deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.foot__note{
  font-family:var(--mono); font-size:13px; letter-spacing:.12em; color:var(--muted); margin:0;
}
.foot__hint{ color:var(--muted-2); margin-left:10px }
.foot__legal{ font-size:11.5px; line-height:1.6; color:var(--muted-2); margin:8px auto 0; max-width:60ch; letter-spacing:.01em }


/* language levels */
.langs{ padding:18px 22px 20px; border-top:1px solid var(--line) }
.langs__label{
  font-family:var(--mono); font-size:12px; letter-spacing:.22em; text-transform:uppercase;
  color:var(--muted-2); margin:0 0 12px;
}
.langs ul{ display:grid; gap:9px }
.langs li{ display:flex; align-items:center; gap:14px; font-size:14px; font-weight:500 }
.langs li span{ margin-right:auto }
.lvl{ display:flex; gap:5px; flex:0 0 auto }
.lvl b{
  width:7px; height:7px; border-radius:50%;
  background:rgba(255,255,255,.13); transition:background .3s;
}
.lvl b.on{ background:var(--accent) }

/* footer slogan */
.foot__slogan{
  font-family:var(--mono); font-size:15px; font-weight:600;
  letter-spacing:.34em; text-transform:uppercase; color:var(--text); margin:0;
}
.foot__slogan b{ color:var(--m-red); font-weight:600 }

/* static (non-link) contact row */
.link-row--static{ color:var(--muted) }
.link-row--static:hover{ padding-left:4px }

/* ============================================================
   13. HUD SPEEDOMETER + M TOAST
   ============================================================ */
.hud{
  position:fixed; right:22px; bottom:22px; z-index:100;
  width:76px; height:76px; padding:0; cursor:pointer; color:var(--text);
  background:rgba(10,12,15,.82); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  border:1px solid var(--line); border-radius:50%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  opacity:0; pointer-events:none; transform:scale(.85) translateY(10px);
  transition:opacity .6s var(--ease),transform .6s var(--ease-out),border-color .3s;
}
.hud.show{ opacity:1; pointer-events:auto; transform:none }
.hud:hover{ border-color:var(--line-2) }
.hud svg{ position:absolute; inset:5px; width:calc(100% - 10px); height:calc(100% - 10px); transform:rotate(-90deg) }
.hud__ring-bg{ fill:none; stroke:rgba(255,255,255,.10); stroke-width:4 }
.hud__ring{
  fill:none; stroke:var(--accent); stroke-width:4; stroke-linecap:round;
  stroke-dasharray:276.5; stroke-dashoffset:276.5; transition:stroke-dashoffset .2s linear,stroke .6s;
}
.hud__val{ transition:color .6s; position:relative; font-family:var(--mono); font-size:19px; font-weight:700; line-height:1; letter-spacing:.02em }
.hud.good{ border-color:rgba(63,207,110,.55) }
.hud.bad{ border-color:rgba(231,34,46,.55) }
.hud.good .hud__ring{ stroke:#3FCF6E }
.hud.bad .hud__ring{ stroke:var(--m-red) }
.hud.good .hud__val{ color:#3FCF6E }
.hud.bad .hud__val{ color:var(--m-red) }

/* 0-100 launch timer */
.launch{
  position:fixed; right:22px; bottom:110px; z-index:100;
  min-width:128px; padding:10px 14px 11px; text-align:right;
  background:rgba(10,12,15,.88); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  border:1px solid var(--line-2); border-radius:var(--r);
  opacity:0; transform:translateY(8px); pointer-events:none;
  transition:opacity .35s var(--ease),transform .45s var(--ease-out),border-color .3s;
}
.launch.show{ opacity:1; transform:none }
.launch::before{
  content:""; position:absolute; left:0; top:0; bottom:0; width:3px;
  background:linear-gradient(180deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
}
.launch__k{ display:block; font-family:var(--mono); font-size:11px; font-weight:600; letter-spacing:.2em; color:var(--muted) }
.launch__t{ display:block; font-family:var(--mono); font-size:30px; font-weight:700; line-height:1.05; letter-spacing:.02em; color:#fff; font-variant-numeric:tabular-nums }
.launch__m{ display:block; font-family:var(--mono); font-size:11px; letter-spacing:.14em; color:var(--muted-2); min-height:1.3em }
.launch.good{ border-color:rgba(63,207,110,.6) }
.launch.good .launch__t,.launch.good .launch__m{ color:#3FCF6E }
.launch.bad{ border-color:rgba(231,34,46,.6) }
.launch.bad .launch__t,.launch.bad .launch__m{ color:var(--m-red) }
.launch.pop{ animation:launchPop .5s var(--ease-out) }
@keyframes launchPop{ 40%{ transform:scale(1.08) } }

.hud__unit{ position:relative; font-family:var(--mono); font-size:9px; letter-spacing:.18em; color:var(--muted); margin-top:3px }

.mtoast{
  position:fixed; left:50%; bottom:34px; transform:translate(-50%,20px); z-index:130;
  font-family:var(--mono); font-size:13px; font-weight:600; letter-spacing:.3em;
  padding:12px 26px; border-radius:var(--r); color:#fff;
  background:rgba(10,12,15,.9); backdrop-filter:blur(10px);
  border:1px solid var(--line-2); opacity:0; pointer-events:none;
  transition:opacity .4s,transform .5s var(--ease-out);
}
.mtoast::before{
  content:""; position:absolute; left:0; top:0; bottom:0; width:3px;
  background:linear-gradient(180deg,var(--m-light),var(--m-blue) 50%,var(--m-red));
}
.mtoast.show{ opacity:1; transform:translate(-50%,0) }

/* ============================================================
   14. RESPONSIVE
   ============================================================ */
@media (max-width:1040px){
  .profile{ grid-template-columns:1fr }
  .pillars{ grid-template-columns:1fr }
  .contact__box{ grid-template-columns:1fr }
  .spec{ grid-template-columns:repeat(2,1fr) }
}
@media (max-width:900px){
  .nav__links{
    position:fixed; inset:0; z-index:-1;
    flex-direction:column; justify-content:center; align-items:center; gap:6px;
    background:rgba(8,9,11,.97); backdrop-filter:blur(16px);
    opacity:0; pointer-events:none; transition:opacity .4s var(--ease);
  }
  .nav__links a{ font-size:22px; padding:14px }
  .nav__links a::after{ display:none }
  body.nav-open .nav__links{ opacity:1; pointer-events:auto; z-index:1 }
  .nav__burger{ display:flex; position:relative; z-index:2 }
  .nav__brand{ position:relative; z-index:2 }
  /* backdrop-filter on the stuck bar traps the fixed overlay inside the bar; drop it while open */
  body.nav-open .nav,body.nav-open .nav.stuck{ backdrop-filter:none; -webkit-backdrop-filter:none; background:transparent; border-bottom-color:transparent }
  .nav__cta{ display:none }
  .garage{ grid-template-columns:1fr }
  .gauges{ grid-template-columns:repeat(2,1fr) }
  .hud{ width:66px; height:66px; right:14px; bottom:14px }
  .hud__val{ font-size:17px }
  .launch{ right:14px; bottom:92px }
}
@media (max-width:620px){
  .hero{ padding-top:104px }
  .hero__name{ letter-spacing:-.045em }
  .spec{ grid-template-columns:1fr }
  .route::before{ left:5px }
  .route__i{ grid-template-columns:1fr; gap:6px; padding-left:30px; position:relative }
  .route__yr{ padding-top:0 }
  .route__c{ margin-left:0 }
  .route__c::before{ left:-30px; top:22px }
  .gauges{ grid-template-columns:1fr }
  .car__stats{ gap:18px; flex-wrap:wrap }
  .foot__hint{ display:block; margin:6px 0 0 }
}

/* ---------- 15. MOTION PREFERENCES ---------- */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important }
  html{ scroll-behavior:auto }
  .reveal{ opacity:1; transform:none }
}


html,body{background:var(--ink) !important;color:var(--text)}

	</style>
</head>
<body>
<script is:inline>document.body.className = 'is-booting';</script>

<!-- ================= BOOT / LOADING SCREEN ================= -->
<div id="boot" class="boot" role="status" aria-label="Loading">
  <div class="boot__stripes" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="boot__center">
    <svg class="boot__mark" viewBox="-14 -14 128 128" aria-hidden="true">
      <defs>
        <linearGradient id="bootSweep" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#009ADA"/>
          <stop offset="50%" stop-color="#0653B6"/>
          <stop offset="100%" stop-color="#E7222E"/>
        </linearGradient>
      </defs>

      <circle class="boot__ring-bg" cx="50" cy="50" r="57"/>
      <circle class="boot__ring" cx="50" cy="50" r="57" stroke="url(#bootSweep)"/>

      <g class="roundel">
        <circle class="rd-rim" cx="50" cy="50" r="50"/>
        <circle class="rd-ring" cx="50" cy="50" r="48.4"/>
        <circle class="rd-inner" cx="50" cy="50" r="29.5"/>
        <path class="rd-q" d="M50 50 L50 20.5 A29.5 29.5 0 0 0 20.5 50 Z"/>
        <path class="rd-q" d="M50 50 L50 79.5 A29.5 29.5 0 0 0 79.5 50 Z"/>
        <g class="rd-txt">
          <g transform="rotate(-45 50 50)"><text x="50" y="17.42" text-anchor="middle">Y</text></g>
          <text x="50" y="17.42" text-anchor="middle">S</text>
          <g transform="rotate(45 50 50)"><text x="50" y="17.42" text-anchor="middle">A</text></g>
        </g>
      </g>
    </svg>

    <div class="boot__meta">
      <div class="boot__title">PORTFOLIO OS <span>v2.026</span></div>
      <div class="boot__log" id="bootLog" aria-hidden="true"></div>
    </div>

    <div class="boot__bar">
      <div class="boot__bar-track"><div class="boot__bar-fill" id="bootFill"></div></div>
      <div class="boot__bar-num"><span id="bootPct">0</span><em>%</em></div>
    </div>
  </div>

  <button class="boot__skip" id="bootSkip" type="button">Skip intro <kbd>Esc</kbd></button>
  <div class="boot__curtain boot__curtain--l" aria-hidden="true"></div>
  <div class="boot__curtain boot__curtain--r" aria-hidden="true"></div>
</div>

<!-- ================= SCROLL PROGRESS ================= -->
<div class="progress" aria-hidden="true"><i id="progressFill"></i></div>

<!-- ================= NAV ================= -->
<header class="nav" id="nav">
  <a class="nav__brand" href="#hero" aria-label="Yavuz Atilgan, home">
    <span class="nav__logo" aria-hidden="true">
      <svg viewBox="0 0 100 100" class="roundel">
        <circle class="rd-rim" cx="50" cy="50" r="50"/>
        <circle class="rd-ring" cx="50" cy="50" r="48.4"/>
        <circle class="rd-inner" cx="50" cy="50" r="29.5"/>
        <path class="rd-q" d="M50 50 L50 20.5 A29.5 29.5 0 0 0 20.5 50 Z"/>
        <path class="rd-q" d="M50 50 L50 79.5 A29.5 29.5 0 0 0 79.5 50 Z"/>
        <g class="rd-txt">
          <g transform="rotate(-45 50 50)"><text x="50" y="17.42" text-anchor="middle">Y</text></g>
          <text x="50" y="17.42" text-anchor="middle">S</text>
          <g transform="rotate(45 50 50)"><text x="50" y="17.42" text-anchor="middle">A</text></g>
        </g>
      </svg>
    </span>
    <span class="nav__name">YAVUZ <b>A</b></span>
  </a>
  <nav class="nav__links" id="navLinks">
    <a href="#profile" data-nav>Profile</a>
    <a href="#performance" data-nav>Performance</a>
    <a href="#garage" data-nav>Garage</a>
    <a href="#route" data-nav>Route</a>
    <a href="#bmw" data-nav>Why BMW</a>
  </nav>
  <a class="btn btn--sm nav__cta" href="#contact">Contact <svg viewBox="0 0 24 24" class="ico"><path d="M4 12h14M13 6l6 6-6 6"/></svg></a>
  <button class="nav__burger" id="navBurger" type="button" aria-label="Menu"><i></i><i></i><i></i></button>
</header>

<main>

<!-- ================= HERO ================= -->
<section class="hero" id="hero">
  <canvas class="hero__stars" id="stars" aria-hidden="true"></canvas>
  <div class="hero__grille" aria-hidden="true"><span></span><span></span></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__inner">
