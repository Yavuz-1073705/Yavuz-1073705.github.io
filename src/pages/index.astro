    { name: 'PHP / Node.js',           rpm: 7.9, meta: 'Back-end' },
    { name: 'Java / Python',           rpm: 7.6, meta: 'OOP & AI' },
    { name: 'SQL / PhpMyAdmin',        rpm: 7.7, meta: 'Data' },
    { name: 'Kotlin / Swift',          rpm: 7.1, meta: 'Android & iOS' }
  ];

  var GA_MAX = 9;
  var GA_R = 44, GA_CX = 60, GA_CY = 60, GA_SPAN = 250, GA_START = -125;
  var ARC_LEN = (GA_SPAN / 360) * 2 * Math.PI * GA_R;

  function polar(deg, r) {
    var rad = deg * Math.PI / 180;
    return [GA_CX + r * Math.sin(rad), GA_CY - r * Math.cos(rad)];
  }
  function arcPath(a1, a2, r) {
    var p1 = polar(a1, r), p2 = polar(a2, r);
    var large = Math.abs(a2 - a1) > 180 ? 1 : 0;
    return 'M' + p1[0].toFixed(2) + ' ' + p1[1].toFixed(2) +
           ' A' + r + ' ' + r + ' 0 ' + large + ' 1 ' + p2[0].toFixed(2) + ' ' + p2[1].toFixed(2);
  }

  function buildGauges() {
    var host = $('#gauges');
    if (!host) return;

    var ticks = '';
    for (var i = 0; i <= GA_MAX; i++) {
      var a = GA_START + (i / GA_MAX) * GA_SPAN;
      var o = polar(a, 33), n = polar(a, i % 2 === 0 ? 25 : 29);
      ticks += '<path class="g-tick" d="M' + o[0].toFixed(2) + ' ' + o[1].toFixed(2) +
               ' L' + n[0].toFixed(2) + ' ' + n[1].toFixed(2) + '"/>';
    }

    var track = arcPath(GA_START, GA_START + GA_SPAN, GA_R);
    var redzone = arcPath(GA_START + GA_SPAN * (8 / GA_MAX), GA_START + GA_SPAN, GA_R);

    host.innerHTML = SKILLS.map(function (s) {
      var p = clamp(s.rpm, 0, GA_MAX) / GA_MAX;
      var deg = GA_START + p * GA_SPAN;
      var off = ARC_LEN * (1 - p);
      return '' +
      '<div class="gauge reveal" style="--len:' + ARC_LEN.toFixed(1) + ';--off:' + off.toFixed(1) + ';--deg:' + deg.toFixed(1) + 'deg">' +
        '<svg class="gauge__svg" viewBox="0 0 120 120" aria-hidden="true">' +
          '<path class="g-track" d="' + track + '"/>' +
          '<path class="g-red" d="' + redzone + '"/>' +
          ticks +
          '<path class="g-fill" d="' + track + '"/>' +
          '<g class="g-needle"><path d="M60 60 L60 20"/></g>' +
          '<circle class="g-hub" cx="60" cy="60" r="3.4"/>' +
          '<text class="g-val" x="60" y="86" text-anchor="middle">' + s.rpm.toFixed(1) + '</text>' +
          '<text class="g-unit" x="60" y="99" text-anchor="middle">RPM &#215;1000</text>' +
        '</svg>' +
        '<h3 class="gauge__name">' + s.name + '</h3>' +
        '<p class="gauge__meta">' + s.meta + '</p>' +
      '</div>';
    }).join('');
  }

  /* ==========================================================
     2. STARFIELD: stars that break apart
     ========================================================== */
  var Stars = (function () {
    var cv = $('#stars'), ctx, W = 0, H = 0, dpr = 1, stars = [], shards = [], raf = null;
    var mx = 0, my = 0, tmx = 0, tmy = 0, t = 0;

    function resize() {
      if (!cv) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      var r = cv.getBoundingClientRect();
      W = r.width; H = r.height;
      cv.width = W * dpr; cv.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      var count = clamp(Math.round((W * H) / 7000), 60, 340);
      stars = [];
      for (var i = 0; i < count; i++) {
        var depth = Math.random();
        stars.push({
          x: Math.random() * W, y: Math.random() * H,
          hx: 0, hy: 0, vx: 0, vy: 0,
          d: depth,
          r: 0.35 + depth * 1.5,
          a: 0.18 + Math.random() * 0.6,
          tw: Math.random() * Math.PI * 2,
          ts: 0.6 + Math.random() * 1.8
        });
      }
    }

    /* the "break": a shockwave from a point pushes every star outward
       and spawns M-coloured shards that fly off and fade */
    function burst(cx, cy, power) {
      power = power || 1;
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        var dx = s.x - cx, dy = s.y - cy;
        var dist = Math.sqrt(dx * dx + dy * dy) || 1;
        var force = (power * 2600) / (dist + 120);
        s.vx += (dx / dist) * force * 0.09;
        s.vy += (dy / dist) * force * 0.09;
      }
      var cols = ['#009ADA', '#0653B6', '#E7222E', '#FFFFFF', '#FFFFFF'];
      var n = Math.round(46 * power);
      for (var j = 0; j < n; j++) {
        var ang = Math.random() * Math.PI * 2;
        var sp = 2.2 + Math.random() * 7.5;
        shards.push({
          x: cx + (Math.random() - 0.5) * 60,
          y: cy + (Math.random() - 0.5) * 90,
          vx: Math.cos(ang) * sp * 1.7,
          vy: Math.sin(ang) * sp,
          len: 8 + Math.random() * 30,
          w: 0.8 + Math.random() * 2,
          life: 1,
          decay: 0.008 + Math.random() * 0.016,
          col: cols[(Math.random() * cols.length) | 0]
        });
      }
      if (!raf && visible) loop();
    }

    function frame() {
      t += 0.016;
      mx += (tmx - mx) * 0.05;
      my += (tmy - my) * 0.05;
      ctx.clearRect(0, 0, W, H);

      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.vx *= 0.94; s.vy *= 0.94;
        s.hx += s.vx; s.hy += s.vy;
        s.hx *= 0.985; s.hy *= 0.985;

        var px = s.x + s.hx + mx * (6 + s.d * 26);
        var py = s.y + s.hy + my * (6 + s.d * 26);
        if (px < -20) px += W + 40; else if (px > W + 20) px -= W + 40;
        if (py < -20) py += H + 40; else if (py > H + 20) py -= H + 40;

        var tw = 0.65 + 0.35 * Math.sin(t * s.ts + s.tw);
        ctx.globalAlpha = s.a * tw;
        ctx.fillStyle = s.d > 0.86 ? '#BFE3F7' : '#FFFFFF';
        ctx.beginPath();
        ctx.arc(px, py, s.r, 0, 6.2832);
        ctx.fill();
      }

      for (var k = shards.length - 1; k >= 0; k--) {
        var sh = shards[k];
        sh.x += sh.vx; sh.y += sh.vy;
        sh.vx *= 0.975; sh.vy *= 0.975; sh.vy += 0.045;
        sh.life -= sh.decay;
        if (sh.life <= 0) { shards.splice(k, 1); continue; }
        ctx.globalAlpha = Math.max(sh.life, 0) * 0.9;
        ctx.strokeStyle = sh.col;
        ctx.lineWidth = sh.w;
        ctx.beginPath();
        ctx.moveTo(sh.x, sh.y);
        ctx.lineTo(sh.x - sh.vx * (sh.len / 8), sh.y - sh.vy * (sh.len / 8));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    var visible = true;
    function loop() {
      if (!visible) { raf = null; return; }   // fully stop when off-screen
      raf = requestAnimationFrame(loop);
      frame();
    }
    function setVisible(v) {
      visible = v;
      document.body.classList.toggle('hero-paused', !v);
      if (v && !raf && !reduced) loop();
    }

    function init() {
      if (!cv) return;
      ctx = cv.getContext('2d');
      resize();
      window.addEventListener('resize', resize);

      if (reduced) { frame(); return; }

      window.addEventListener('mousemove', function (e) {
        tmx = (e.clientX / window.innerWidth - 0.5) * 2;
        tmy = (e.clientY / window.innerHeight - 0.5) * 2;
      }, { passive: true });

      // pause the loop when the hero scrolls out of view
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) { setVisible(es[0].isIntersecting); })
          .observe(cv);
      }
      document.addEventListener('visibilitychange', function () {
        setVisible(!document.hidden && visible);
      });
      loop();
    }

    return { init: init, burst: burst, ready: function () { return !!ctx; } };
  })();

  /* ==========================================================
     3. BOOT SEQUENCE
     ========================================================== */
  var LOG = [
    ['Initialising drivetrain', 'OK'],
    ['Loading M performance profile', 'OK'],
    ['Calibrating skill telemetry', 'OK'],
    ['Driver: YAVUZ ATILGAN', 'VERIFIED'],
    ['Destination: BMW GROUP', 'SET']
  ];

  function boot() {
    var el = $('#boot'), fill = $('#bootFill'), pct = $('#bootPct'), log = $('#bootLog');
    if (!el) { start(); return; }

    var seen = false;
    try { seen = sessionStorage.getItem('ya-booted') === '1'; } catch (e) {}
    var DUR = reduced ? 400 : (seen ? 1100 : 2900);

    // log lines
    if (log) {
      LOG.forEach(function (row, i) {
        var d = document.createElement('div');
        var dots = new Array(Math.max(2, 30 - row[0].length)).join('.');
        d.innerHTML = '<span>&rsaquo; ' + row[0] + ' ' + dots + '</span><b' +
                      (row[1] === 'SET' ? ' class="warn"' : '') + '>' + row[1] + '</b>';
        d.style.animationDelay = (0.25 + i * (DUR / 1000 - 0.5) / LOG.length) + 's';
        log.appendChild(d);
      });
    }

    var t0 = performance.now(), done = false;
    function tick(now) {
      var p = clamp((now - t0) / DUR, 0, 1);
      var eased = 1 - Math.pow(1 - p, 2.2);
      if (fill) fill.style.width = (eased * 100).toFixed(1) + '%';
      if (pct) pct.textContent = Math.round(eased * 100);
      if (p < 1) requestAnimationFrame(tick); else finish();
    }
    function finish() {
      if (done) return; done = true;
      try { sessionStorage.setItem('ya-booted', '1'); } catch (e) {}
      if (fill) fill.style.width = '100%';
      if (pct) pct.textContent = '100';
      el.classList.add('done');
      document.body.classList.remove('is-booting');
      start();
      setTimeout(function () { el.classList.add('gone'); }, 1200);
    }

    $('#bootSkip').addEventListener('click', finish);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') finish();
    });
    requestAnimationFrame(tick);
  }

  /* fired the moment the curtain opens */
  function start() {
    revealAll();
    var hero = $('#hero');
    if (!hero || reduced || !Stars.ready()) return;
    var a = $('.hero__a');
    setTimeout(function () {
      var r = hero.getBoundingClientRect();
      var cx = r.width / 2, cy = r.height / 2;
      if (a) {
        var ar = a.getBoundingClientRect();
        cx = ar.left - r.left + ar.width / 2;
        cy = ar.top - r.top + ar.height / 2;
      }
      Stars.burst(cx, cy, 1.35);
    }, 260);
  }

  /* ==========================================================
     4. REVEAL ON SCROLL
     ========================================================== */
  var io = null;
  function revealAll() {
    var items = $$('.reveal');
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(function (n) { n.classList.add('in'); });
      $$('.car,.gauge').forEach(function (n) { n.classList.add('in'); });
      return;
    }
    if (!io) {
      io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          var n = en.target;
          var sibs = $$('.reveal', n.parentNode);
          var idx = Math.max(0, sibs.indexOf(n));
          n.style.transitionDelay = Math.min(idx * 90, 450) + 'ms';
          n.classList.add('in');
          io.unobserve(n);
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    }
    items.forEach(function (n) { io.observe(n); });
  }

  /* ==========================================================
     5. NAV / PROGRESS / HUD
     ========================================================== */
  function chrome() {
    var nav = $('#nav'), bar = $('#progressFill'), hud = $('#hud');
    var hudArc = $('#hudArc'), hudVal = $('#hudVal');
    var links = $$('#navLinks a');
    var secs = links.map(function (a) { return $(a.getAttribute('href')); });
    var HUD_LEN = 276.5;
    var shownVal = 0, hudTarget = 0, hudRaf = null;
    function hudEase() {
      shownVal += (hudTarget - shownVal) * 0.2;
      if (Math.abs(hudTarget - shownVal) < 0.5) shownVal = hudTarget;
      if (hudVal) hudVal.textContent = Math.round(shownVal);
      hudRaf = shownVal === hudTarget ? null : requestAnimationFrame(hudEase);
    }

    /* ---- 0-100 km/h launch timer ---- */
    var launch = $('#launch'), launchT = $('#launchT');
    var L = { armed: true, running: false, t0: 0, raf: null, hide: null };
    function fmt(sec) { return sec.toFixed(2).replace('.', ',') + 's'; }
    function liveTick() {
      if (!L.running) return;
      if (launchT) launchT.textContent = fmt((performance.now() - L.t0) / 1000);
      L.raf = requestAnimationFrame(liveTick);
    }
    function launchReset() {
      L.armed = true; L.running = false;
      cancelAnimationFrame(L.raf); clearTimeout(L.hide);
      if (launch) launch.classList.remove('show', 'good', 'bad', 'pop');
      if (hud) hud.classList.remove('good', 'bad');
    }
    function launchCheck(kmh) {
      if (!launch) return;
      if (kmh === 0) { if (!L.armed) launchReset(); return; }
      if (L.armed) {
        L.armed = false; L.running = true; L.t0 = performance.now();
        clearTimeout(L.hide);
        launch.classList.remove('good', 'bad', 'pop');
        launch.classList.add('show');
        liveTick();
        return;
      }
      if (L.running && kmh >= 100) {
        L.running = false; cancelAnimationFrame(L.raf);
        var sec = (performance.now() - L.t0) / 1000;
        var good = sec < 7;
        launchT.textContent = fmt(sec);
        launch.classList.add(good ? 'good' : 'bad');
        void launch.offsetWidth; launch.classList.add('pop');
        if (hud) { hud.classList.remove('good', 'bad'); hud.classList.add(good ? 'good' : 'bad'); }
        L.hide = setTimeout(function () {
          launch.classList.remove('show');
          if (hud) hud.classList.remove('good', 'bad');
        }, 4000);
      }
    }

    function onScroll() {
      var y = window.scrollY || document.documentElement.scrollTop;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var p = max > 0 ? clamp(y / max, 0, 1) : 0;

      if (bar) bar.style.width = (p * 100).toFixed(2) + '%';
      nav.classList.toggle('stuck', y > 24);

      if (hud) {
        hud.classList.toggle('show', y > 260);
        var target = Math.round(p * 300);
        hudTarget = target;
        if (!hudRaf) hudRaf = requestAnimationFrame(hudEase);
        if (hudArc) hudArc.style.strokeDashoffset = (HUD_LEN * (1 - p)).toFixed(1);
        if (!document.body.classList.contains('nav-open')) launchCheck(target);
      }

      // active nav link
      var mid = y + window.innerHeight * 0.34, act = -1;
      secs.forEach(function (s, i) { if (s && s.offsetTop <= mid) act = i; });
      links.forEach(function (a, i) { a.classList.toggle('active', i === act); });
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { onScroll(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
    if (hud) hud.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    // mobile menu
    var burger = $('#navBurger');
    if (burger) {
      var lockY = 0;
      var openNav = function () {
        lockY = window.scrollY || window.pageYOffset || 0;
        document.body.style.top = (-lockY) + 'px';
        document.body.classList.add('nav-open');
      };
      var closeNav = function () {
        if (!document.body.classList.contains('nav-open')) return;
        document.body.classList.remove('nav-open');
        document.body.style.top = '';
        var html = document.documentElement, prev = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        window.scrollTo(0, lockY);
        html.style.scrollBehavior = prev;
      };
      burger.addEventListener('click', function () {
        document.body.classList.contains('nav-open') ? closeNav() : openNav();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeNav(); });
      window.addEventListener('resize', function () { if (window.innerWidth > 900) closeNav(); });
      $$('#navLinks a').forEach(function (a) {
        a.addEventListener('click', closeNav);
      });
    }
  }

  /* ==========================================================
     6. INTERACTIONS: shatter on click + M mode easter egg
     ========================================================== */
  function extras() {
    var name = $('#heroName'), hero = $('#hero');
    if (name && hero) {
      name.addEventListener('click', function () {
        name.classList.remove('shatter');
        void name.offsetWidth;
        name.classList.add('shatter');
        var r = hero.getBoundingClientRect(), nr = name.getBoundingClientRect();
        Stars.burst(nr.left - r.left + nr.width * 0.78, nr.top - r.top + nr.height / 2, 1.1);
      });
    }

    var toast = $('#mtoast'), tid = null;
    function toggleM() {
      var on = document.body.classList.toggle('m-mode');
      if (!toast) return;
      toast.textContent = on ? 'M MODE ENGAGED' : 'COMFORT MODE';
      toast.classList.add('show');
      clearTimeout(tid);
      tid = setTimeout(function () { toast.classList.remove('show'); }, 1800);
    }
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      var tag = (e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      if (e.key === 'm' || e.key === 'M') toggleM();
    });

    // placeholder links -> tell the visitor instead of going nowhere
    $$('[data-fill]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (a.getAttribute('href') === '#') {
          e.preventDefault();
          var v = $('.link-row__v', a);
          if (v && !v.dataset.warned) { v.dataset.warned = '1'; v.textContent += '  (add your URL)'; }
        }
      });
    });
  }


  /* language proficiency dots, driven by data-lvl */
  function buildLanguages() {
    $$('.lvl').forEach(function (el) {
      var lvl = parseInt(el.getAttribute('data-lvl'), 10) || 0;
      var html = '';
      for (var i = 1; i <= 5; i++) html += '<b class="' + (i <= lvl ? 'on' : '') + '"></b>';
      el.innerHTML = html;
      var li = el.parentNode;
      var label = li.firstElementChild ? li.firstElementChild.textContent : '';
      el.setAttribute('aria-label', label + ': ' + lvl + ' out of 5');
      el.setAttribute('role', 'img');
    });
  }

  /* ==========================================================
     BOOTSTRAP
     ========================================================== */
  buildLanguages();
  buildGauges();
  Stars.init();
  chrome();
  extras();
  boot();
})();

</script>
</body>
</html>
